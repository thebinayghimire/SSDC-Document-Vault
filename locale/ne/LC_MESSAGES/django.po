msgid "%(added)s added to library. %(checking)s awaiting checks. %(rejected)s rejected. %(remaining)s need attention."
msgstr "%(added)s पुस्तकालयमा थपिए। %(checking)s जाँचको प्रतीक्षामा छन्। %(rejected)s अस्वीकृत भए। %(remaining)s फाइलमा ध्यान दिनुहोस्।"

msgid "%(count)s already queued"
msgstr "%(count)s सूचीमा पहिल्यै छन्"

msgid "%(count)s beyond the batch limit"
msgstr "%(count)s फाइल एक पटकको सीमाभन्दा बढी"

msgid "%(count)s empty files"
msgstr "%(count)s खाली फाइल"

msgid "%(count)s files added."
msgstr "%(count)s फाइल थपिए।"

msgid "%(count)s over the %(size)s limit"
msgstr "%(count)s फाइल %(size)s सीमाभन्दा ठूला"

msgid "%(count)s unsupported files"
msgstr "%(count)s फाइलको प्रकार मिलेन"

msgid "%(name)s removed from the queue."
msgstr "%(name)s सूचीबाट हटाइयो।"

msgid ". To upload, sign in with an administrator account or ask your administrator to assign the Document manager role and manage access to a folder."
msgstr "। अपलोड गर्न प्रशासक खाताबाट साइन इन गर्नुहोस् वा प्रशासकसँग कागजात व्यवस्थापकको भूमिका र फोल्डर व्यवस्थापन अनुमति माग्नुहोस्।"

msgid "A place for every document"
msgstr "हरेक कागजातको आफ्नै ठाउँ"

msgid "A restricted folder uses its own grants. Manage staff access in Administration."
msgstr "सीमित फोल्डरमा छुट्टै अनुमति लागू हुन्छ। प्रशासनबाट कर्मचारीको पहुँच व्यवस्थापन गर्नुहोस्।"

msgid "Access follows your account permissions."
msgstr "तपाईंको खाताको अनुमतिअनुसार पहुँच दिइन्छ।"

msgid "Account security"
msgstr "खाताको सुरक्षा"

msgid "Account security · Step 1 of 2"
msgstr "खाताको सुरक्षा · चरण १ मध्ये २"

msgid "Account security · Step 2 of 2"
msgstr "खाताको सुरक्षा · चरण २ मध्ये २"

msgid "Accounts, access, and oversight."
msgstr "खाता, पहुँच र अनुगमन।"

msgid "Actions"
msgstr "कार्यहरू"

msgid "Active"
msgstr "सक्रिय"

msgid "Add"
msgstr "थप्नुहोस्"

msgid "Add a file and give it a clear, recognisable title."
msgstr "फाइल थप्नुहोस् र सजिलै चिनिने शीर्षक दिनुहोस्।"

msgid "Add documents"
msgstr "कागजात थप्नुहोस्"

msgid "Add documents here once your account has upload access."
msgstr "अपलोड अनुमति पाएपछि यहाँ कागजात थप्नुहोस्।"

msgid "Added to library"
msgstr "पुस्तकालयमा थपियो"

msgid "Admin portal"
msgstr "प्रशासक पोर्टल"

msgid "Admin sign in"
msgstr "प्रशासक साइन इन"

msgid "Admin sign in."
msgstr "प्रशासक साइन इन"

msgid "Administration"
msgstr "प्रशासन"

msgid "All file types"
msgstr "सबै प्रकारका फाइल"

msgid "All folders"
msgstr "सबै फोल्डर"

msgid "All states"
msgstr "सबै अवस्था"

msgid "An internal document library operated by Siddhartha Social Development Centre for authorized staff."
msgstr "सिद्धार्थ सामाजिक विकास केन्द्रका अधिकारप्राप्त कर्मचारीका लागि सञ्चालित आन्तरिक कागजात पुस्तकालय।"

msgid "Apply"
msgstr "लागू गर्नुहोस्"

msgid "Archive document"
msgstr "अभिलेखमा राख्नुहोस्"

msgid "Archived"
msgstr "अभिलेखमा"

msgid "Archived documents are hidden from the staff library. Unarchive to make this document available again."
msgstr "अभिलेखका कागजात कर्मचारी पुस्तकालयमा देखिँदैनन्। फेरि उपलब्ध गराउन पुस्तकालयमा फर्काउनुहोस्।"

msgid "Ask your administrator to give you manage access to a folder. You can then import documents here."
msgstr "प्रशासकसँग फोल्डर व्यवस्थापनको अनुमति माग्नुहोस्। त्यसपछि यहाँ कागजात ल्याउन सक्नुहुन्छ।"

msgid "Audit &amp; activity"
msgstr "लेखापरीक्षण र गतिविधि"

msgid "Authenticator or recovery code"
msgstr "प्रमाणक वा पुनःप्राप्ति कोड"

msgid "Awaiting checks"
msgstr "जाँचको प्रतीक्षामा"

msgid "Awaiting publication"
msgstr "प्रकाशनको प्रतीक्षामा"

msgid "Back to sign in"
msgstr "साइन इनमा फर्कनुहोस्"

msgid "Before you upload"
msgstr "अपलोड गर्नुअघि"

msgid "Breadcrumb"
msgstr "पृष्ठ मार्ग"

msgid "Bring files into your vault"
msgstr "भण्डारमा फाइल थप्नुहोस्"

msgid "Bring your files together, ready to share with your team."
msgstr "आफ्नो टोलीसँग साझा गर्न फाइलहरू एकै ठाउँमा राख्नुहोस्।"

msgid "Browse a shared folder, or contact your administrator for document access."
msgstr "साझा फोल्डर हेर्नुहोस् वा कागजात पहुँचका लागि प्रशासकलाई सम्पर्क गर्नुहोस्।"

msgid "Browse by folder to find related documents."
msgstr "सम्बन्धित कागजात भेट्न फोल्डरअनुसार हेर्नुहोस्।"

msgid "Browse folders"
msgstr "फोल्डर हेर्नुहोस्"

msgid "Browse library"
msgstr "पुस्तकालय हेर्नुहोस्"

msgid "Browse shared folders or find the document you need."
msgstr "साझा फोल्डर हेर्नुहोस् वा चाहिएको कागजात खोज्नुहोस्।"

msgid "Browse the documents shared in this folder."
msgstr "यस फोल्डरमा साझा गरिएका कागजात हेर्नुहोस्।"

msgid "Cancel"
msgstr "रद्द गर्नुहोस्"

msgid "Change"
msgstr "बदल्नुहोस्"

msgid "Change password"
msgstr "पासवर्ड बदल्नुहोस्"

msgid "Check the highlighted fields"
msgstr "देखाइएका विवरण सच्याउनुहोस्"

msgid "Check your upload"
msgstr "अपलोड जाँच्नुहोस्"

msgid "Choose a destination folder to continue."
msgstr "जारी राख्न फोल्डर छान्नुहोस्।"

msgid "Choose a portal"
msgstr "पोर्टल छान्नुहोस्"

msgid "Choose a strong password you haven’t used elsewhere."
msgstr "अन्यत्र प्रयोग नगरेको बलियो पासवर्ड छान्नुहोस्।"

msgid "Choose a vault folder"
msgstr "भण्डारको फोल्डर छान्नुहोस्"

msgid "Choose files"
msgstr "फाइल छान्नुहोस्"

msgid "Choose files, drop a folder, or paste a copied file."
msgstr "फाइल छान्नुहोस्, फोल्डर छोड्नुहोस् वा प्रतिलिपि गरिएको फाइल टाँस्नुहोस्।"

msgid "Clear filters"
msgstr "छनोट हटाउनुहोस्"

msgid "Clear finished"
msgstr "सकिएका हटाउनुहोस्"

msgid "Confirm your credentials to continue with administrative actions."
msgstr "प्रशासनिक काम जारी राख्न आफ्नो पहिचान प्रमाणित गर्नुहोस्।"

msgid "Confirm your identity"
msgstr "आफ्नो पहिचान पुष्टि गर्नुहोस्"

msgid "Connect / reconnect Google Drive"
msgstr "Google Drive जोड्नुहोस् वा फेरि जोड्नुहोस्"

msgid "Connect or reconnect the storage owner's Google account."
msgstr "भण्डारण मालिकको Google खाता जोड्नुहोस् वा फेरि जोड्नुहोस्।"

msgid "Connection interrupted. Check Manage documents before retrying; the file may have arrived."
msgstr "जडान टुट्यो। फाइल पुगिसकेको हुन सक्छ, फेरि प्रयास गर्नुअघि कागजात व्यवस्थापन हेर्नुहोस्।"

msgid "Contact your SSDC administrator."
msgstr "आफ्नो SSDC प्रशासकलाई सम्पर्क गर्नुहोस्।"

msgid "Continue"
msgstr "जारी राख्नुहोस्"

msgid "Could not read this folder. Try the Import folder button instead."
msgstr "फोल्डर पढ्न सकिएन। फोल्डरबाट ल्याउनुहोस् बटन प्रयोग गर्नुहोस्।"

msgid "Could not verify your session. Check your connection or sign in in a new tab, then continue here."
msgstr "सत्र प्रमाणित भएन। जडान जाँच्नुहोस् वा नयाँ ट्याबमा साइन इन गरेर यहाँ जारी राख्नुहोस्।"

msgid "Create a vault folder, then add your documents here."
msgstr "भण्डारमा फोल्डर बनाएर यहाँ कागजात थप्नुहोस्।"

msgid "Create folder"
msgstr "फोल्डर बनाउनुहोस्"

msgid "Create your first folder"
msgstr "पहिलो फोल्डर बनाउनुहोस्"

msgid "Creating folder…"
msgstr "फोल्डर बन्दैछ…"

msgid "Current"
msgstr "हालको"

msgid "Deleted"
msgstr "मेटाइएका"

msgid "Document"
msgstr "कागजात"

msgid "Document Vault"
msgstr "कागजात भण्डार"

msgid "Document checks are already running."
msgstr "कागजातको जाँच चलिरहेको छ।"

msgid "Document checks completed."
msgstr "कागजातको जाँच पूरा भयो।"

msgid "Document contents remain in the storage owner's Google Drive. The application stores document metadata, staff permission grants, and audit records. Uploaded files are validated by type, structure, and size before publication, and each document request is checked against the staff member's current permissions."
msgstr "कागजातको सामग्री भण्डारण मालिकको Google Drive मा रहन्छ। एपले कागजातको विवरण, कर्मचारीको अनुमति र गतिविधिको अभिलेख राख्छ। प्रकाशनअघि फाइलको प्रकार, संरचना र आकार जाँचिन्छ। प्रत्येक कागजात अनुरोधमा कर्मचारीको हालको अनुमति जाँचिन्छ।"

msgid "Document details"
msgstr "कागजातको विवरण"

msgid "Document details updated."
msgstr "कागजातको विवरण अद्यावधिक भयो।"

msgid "Document display"
msgstr "कागजात प्रदर्शन"

msgid "Document library"
msgstr "कागजात पुस्तकालय"

msgid "Document management"
msgstr "कागजात व्यवस्थापन"

msgid "Document name"
msgstr "कागजातको नाम"

msgid "Document page %(page)s of %(total)s"
msgstr "कागजात पृष्ठ %(page)s, जम्मा %(total)s"

msgid "Document preview"
msgstr "कागजात पूर्वावलोकन"

msgid "Document state"
msgstr "कागजातको अवस्था"

msgid "Document storage"
msgstr "कागजात भण्डारण"

msgid "Document title"
msgstr "कागजातको शीर्षक"

msgid "Document title for %(name)s"
msgstr "%(name)s को कागजात शीर्षक"

msgid "Documents"
msgstr "कागजातहरू"

msgid "Documents &amp; permissions"
msgstr "कागजात र अनुमतिहरू"

msgid "Documents available to your account"
msgstr "तपाईंको खातामा उपलब्ध कागजातहरू"

msgid "Documents shared in this folder will appear here."
msgstr "यस फोल्डरमा साझा गरिएका कागजात यहाँ देखिन्छन्।"

msgid "Documents you can manage, including archived and deleted items"
msgstr "अभिलेखमा राखिएका र मेटाइएकासहित तपाईंले व्यवस्थापन गर्न सक्ने कागजात"

msgid "Drop your documents here"
msgstr "कागजात यहाँ छोड्नुहोस्"

msgid "Each code can be used once if you lose access to your authenticator. Store them somewhere private, separate from your password."
msgstr "प्रमाणक एप चलाउन नसके प्रत्येक कोड एक पटक प्रयोग गर्न सकिन्छ। पासवर्डबाट छुट्टै गोप्य ठाउँमा राख्नुहोस्।"

msgid "Enable JavaScript to view this document."
msgstr "यो कागजात हेर्न JavaScript सक्षम गर्नुहोस्।"

msgid "Enter a code from your authenticator app, or use a recovery code."
msgstr "प्रमाणक एपको कोड वा पुनःप्राप्ति कोड राख्नुहोस्।"

msgid "Enter the current code to finish setup."
msgstr "सेटअप पूरा गर्न हालको कोड राख्नुहोस्।"

msgid "Explore folders within"
msgstr "यस भित्रका फोल्डर हेर्नुहोस्"

msgid "File"
msgstr "फाइल"

msgid "File type"
msgstr "फाइलको प्रकार"

msgid "Files are checked before they appear in the library."
msgstr "पुस्तकालयमा देखिनुअघि फाइल जाँचिन्छन्।"

msgid "Files are checked before they become available. You can review the result in document management."
msgstr "उपलब्ध हुनुअघि फाइल जाँचिन्छन्। नतिजा कागजात व्यवस्थापनमा हेर्न सक्नुहुन्छ।"

msgid "Files use this folder’s access permissions."
msgstr "फाइलमा यस फोल्डरकै पहुँच अनुमति लागू हुन्छ।"

msgid "Find documents"
msgstr "कागजात खोज्नुहोस्"

msgid "Finished files cleared."
msgstr "सकिएका फाइल हटाइए।"

msgid "Fit width"
msgstr "चौडाइ मिलाउनुहोस्"

msgid "Folder"
msgstr "फोल्डर"

msgid "Folder access"
msgstr "फोल्डर पहुँच"

msgid "Folder imports include supported files from subfolders. All files go into your selected vault folder; local folder structure is not recreated. Up to 50 files per batch."
msgstr "उपफोल्डरका मिल्ने फाइल पनि ल्याइन्छन्। सबै फाइल छानिएको फोल्डरमा राखिन्छन्। स्थानीय फोल्डर संरचना बनाइँदैन। एक पटकमा ५० फाइलसम्म ल्याउन सकिन्छ।"

msgid "Folders"
msgstr "फोल्डरहरू"

msgid "For authorized staff use only"
msgstr "अधिकारप्राप्त कर्मचारीका लागि मात्र"

msgid "For authorized viewing."
msgstr "अनुमतिप्राप्त प्रयोगकर्ताका लागि।"

msgid "Gallery view"
msgstr "तस्बिर सूचीमा हेर्नुहोस्"

msgid "Grow your library"
msgstr "पुस्तकालय बढाउनुहोस्"

msgid "I've saved my codes"
msgstr "मैले कोड सुरक्षित राखेँ"

msgid "Identity confirmed. You can continue your administrative action."
msgstr "पहिचान पुष्टि भयो। प्रशासनिक काम जारी राख्न सक्नुहुन्छ।"

msgid "Image"
msgstr "तस्बिर"

msgid "Images"
msgstr "तस्बिरहरू"

msgid "Import %(count)s documents"
msgstr "%(count)s कागजात ल्याउनुहोस्"

msgid "Import documents"
msgstr "कागजात ल्याउनुहोस्"

msgid "Import folder"
msgstr "फोल्डरबाट ल्याउनुहोस्"

msgid "Importing %(current)s of %(total)s: %(name)s"
msgstr "%(total)s मध्ये %(current)s ल्याइँदैछ: %(name)s"

msgid "Importing documents…"
msgstr "कागजात ल्याइँदैछ…"

msgid "Keep related documents together in a shared folder."
msgstr "सम्बन्धित कागजात साझा फोल्डरमा सँगै राख्नुहोस्।"

msgid "Keep this folder private in Google Drive. SSDC permissions are managed inside the portal."
msgstr "Google Drive मा यो फोल्डर निजी राख्नुहोस्। SSDC को अनुमति पोर्टलभित्र व्यवस्थापन हुन्छ।"

msgid "Keep this key private. You’ll save your recovery codes next."
msgstr "यो कुञ्जी गोप्य राख्नुहोस्। अर्को चरणमा पुनःप्राप्ति कोड सुरक्षित गर्नुहोस्।"

msgid "Language"
msgstr "भाषा"

msgid "Last updated"
msgstr "पछिल्लो अद्यावधिक"

msgid "Library visibility"
msgstr "पुस्तकालयमा उपलब्धता"

msgid "List view"
msgstr "सूचीमा हेर्नुहोस्"

msgid "Loading preview…"
msgstr "पूर्वावलोकन खुल्दैछ…"

msgid "MFA code (if enabled)"
msgstr "सुरक्षा कोड (सक्षम भएमा)"

msgid "Main navigation"
msgstr "मुख्य नेभिगेसन"

msgid "Manage"
msgstr "व्यवस्थापन"

msgid "Manage accounts, document access, and vault activity with your administrator account."
msgstr "प्रशासक खाताबाट कर्मचारी खाता, कागजात पहुँच र गतिविधि व्यवस्थापन गर्नुहोस्।"

msgid "Manage document"
msgstr "कागजात व्यवस्थापन"

msgid "Manage documents"
msgstr "कागजात व्यवस्थापन"

msgid "Manage staff permissions and review the activity in your document vault."
msgstr "कर्मचारीको अनुमति व्यवस्थापन गर्नुहोस् र भण्डारको गतिविधि हेर्नुहोस्।"

msgid "Manage your documents"
msgstr "आफ्ना कागजात व्यवस्थापन गर्नुहोस्"

msgid "Mobile navigation"
msgstr "मोबाइल नेभिगेसन"

msgid "Move this document to deleted? You can restore it while it is retained."
msgstr "यो कागजात मेटाइएका कागजातमा सार्ने हो? सुरक्षित अवधिभित्र फिर्ता ल्याउन सक्नुहुन्छ।"

msgid "Move to deleted"
msgstr "मेटाइएका कागजातमा सार्नुहोस्"

msgid "Move to deleted?"
msgstr "मेटाइएका कागजातमा सार्ने हो?"

msgid "Name"
msgstr "नाम"

msgid "Name alphabetically"
msgstr "नामअनुसार"

msgid "Name it"
msgstr "नाम दिनुहोस्"

msgid "Need access or help signing in?"
msgstr "पहुँच वा साइन इन गर्न सहयोग चाहिन्छ?"

msgid "New folder"
