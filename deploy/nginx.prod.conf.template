limit_req_zone $binary_remote_addr zone=portal:10m rate=10r/s;
log_format private '$request_id $remote_addr $request_method $status $body_bytes_sent $request_time';
server {
    listen 8080 default_server;
    server_name _;
    return 444;
}
server {
    listen 8080;
    server_name ${PORTAL_HOST};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
        try_files $uri =404;
        access_log off;
    }
    location / {
        return 301 https://${HTTPS_AUTHORITY}$request_uri;
    }
}
server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_certificate /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;
    return 444;
}
server {
    listen 8443 ssl;
    server_name ${PORTAL_HOST};
    ssl_certificate /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size ${REQUEST_BODY_BYTES};
    client_body_timeout 30s;
    access_log /var/log/nginx/access.log private;
    location / {
        limit_req zone=portal burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://app:8000;
        proxy_set_header Host ${HTTPS_AUTHORITY};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 120s;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
    }
}
