# Copy to a private .env.production on Linux; do not use development credentials.
# Build with versioned tags, then deploy the same images by digest from the manifest.
APP_IMAGE=ssdc-app:release-candidate
DB_IMAGE=ssdc-db:release-candidate
SCANNER_IMAGE=ssdc-scanner:release-candidate
PROXY_IMAGE=ssdc-proxy:release-candidate
POSTGRES_DB=ssdc
POSTGRES_USER=ssdc_bootstrap
DB_BOOTSTRAP_PASSWORD_FILE=/srv/ssdc/secrets/db-bootstrap-password
DB_MIGRATION_PASSWORD_FILE=/srv/ssdc/secrets/db-migration-password
DB_PASSWORD_FILE=/srv/ssdc/secrets/db-password
DJANGO_KEY_FILE=/srv/ssdc/secrets/django-key
MFA_KEY_FILE=/srv/ssdc/secrets/mfa-key
GOOGLE_DRIVE_CLIENT_ID_FILE=/srv/ssdc/secrets/google-client-id
GOOGLE_DRIVE_CLIENT_SECRET_FILE=/srv/ssdc/secrets/google-client-secret
GOOGLE_DRIVE_CREDENTIAL_KEY_FILE=/srv/ssdc/secrets/google-credential-key
GOOGLE_DRIVE_REDIRECT_URI=https://vault.example.org/storage/google/callback/
ALLOWED_HOSTS=vault.example.org
HEALTHCHECK_HOST=vault.example.org
CSRF_TRUSTED_ORIGINS=https://vault.example.org
# install_tls.py maintains these links as one certificate pair.
TLS_CERT_FILE=/srv/ssdc/tls/cert.pem
TLS_KEY_FILE=/srv/ssdc/tls/key.pem
TLS_DIRECTORY=/srv/ssdc/tls
ACME_WEBROOT=/srv/ssdc/acme
PORTAL_HOST=vault.example.org
HTTPS_PORT=443
MFA_ALL_STAFF=0
MAX_UPLOAD_BYTES=26214400
MAX_STORAGE_BYTES=10737418240
MAX_IMAGE_PIXELS=20000000
MAX_PDF_PAGES=500
MAX_FOLDERS=1000
SESSION_ABSOLUTE_SECONDS=28800
SESSION_IDLE_SECONDS=1800
LOGIN_IP_LIMIT=300
LOGIN_ACCOUNT_LIMIT=10
PARSER_CONCURRENCY=1
SCANNER_MAX_SIGNATURE_HOURS=72
