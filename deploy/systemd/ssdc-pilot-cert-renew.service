[Unit]
Description=Renew SSDC pilot certificate and reload its proxy
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/ssdc-hosting.conf
ExecStart=/usr/bin/certbot renew --cert-name ${SSDC_PORTAL_HOST} --webroot --webroot-path /srv/ssdc/acme --non-interactive --deploy-hook "/usr/bin/python3 /srv/ssdc/app/scripts/install_tls.py --compose compose.pilot.yaml --env-file /srv/ssdc/.env.pilot --reload-proxy"
TimeoutStartSec=600
UMask=0077
# Add an OnFailure drop-in with the approved alert destination.
