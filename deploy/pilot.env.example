# Copy to /srv/ssdc/.env.pilot (private, 0600). Compose reads it; Django does not.
# All REPLACE values are blockers. This is not permission to provision/publish.
APP_IMAGE=ssdc-app:pilot-candidate
SCANNER_IMAGE=ssdc-scanner:pilot-candidate
PROXY_IMAGE=ssdc-proxy:pilot-candidate
# Copy the endpoint from the intended SSDC project's Connect dialog, Session mode.
POSTGRES_HOST=REPLACE_WITH_SSDC_SESSION_POOLER_HOST
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_CONNECTION_MODE=session
POSTGRES_USER=ssdc_runtime.REPLACE_WITH_SSDC_PROJECT_REF
POSTGRES_MIGRATION_USER=ssdc_migrator.REPLACE_WITH_SSDC_PROJECT_REF
POSTGRES_CONN_MAX_AGE=60
# Host CA bundle for the selected endpoint; mounted as POSTGRES_SSLROOTCERT.
POSTGRES_SSLROOTCERT_FILE=/srv/ssdc/secrets/postgres-root.crt
DB_PASSWORD_FILE=/srv/ssdc/secrets/db-password
DB_MIGRATION_PASSWORD_FILE=/srv/ssdc/secrets/db-migration-password
DJANGO_KEY_FILE=/srv/ssdc/secrets/django-key
MFA_KEY_FILE=/srv/ssdc/secrets/mfa-key
GOOGLE_DRIVE_CLIENT_ID_FILE=/srv/ssdc/secrets/google-client-id
GOOGLE_DRIVE_CLIENT_SECRET_FILE=/srv/ssdc/secrets/google-client-secret
GOOGLE_DRIVE_CREDENTIAL_KEY_FILE=/srv/ssdc/secrets/google-credential-key
# Reserved .invalid hostname: replace only after the user chooses a controlled hostname.
PORTAL_HOST=REPLACE_WITH_HOSTNAME.invalid
ALLOWED_HOSTS=REPLACE_WITH_HOSTNAME.invalid
HEALTHCHECK_HOST=REPLACE_WITH_HOSTNAME.invalid
CSRF_TRUSTED_ORIGINS=https://REPLACE_WITH_HOSTNAME.invalid
GOOGLE_DRIVE_REDIRECT_URI=https://REPLACE_WITH_HOSTNAME.invalid/storage/google/callback/
TLS_DIRECTORY=/srv/ssdc/tls
ACME_WEBROOT=/srv/ssdc/acme
HTTPS_PORT=443
MFA_ALL_STAFF=0
# Optional application limits (defaults shown); production MFA and ClamAV are mandatory.
MAX_UPLOAD_BYTES=26214400
MAX_STORAGE_BYTES=10737418240
MAX_IMAGE_PIXELS=20000000
MAX_PDF_PAGES=500
MAX_FOLDERS=1000
SESSION_ABSOLUTE_SECONDS=28800
SESSION_IDLE_SECONDS=1800
LOGIN_IP_LIMIT=300
LOGIN_ACCOUNT_LIMIT=10
PARSER_CONCURRENCY=1
SCANNER_MAX_SIGNATURE_HOURS=72
