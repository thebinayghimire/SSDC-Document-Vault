FROM nginx:stable-alpine@sha256:47928bf67eb62a1863cb08d9ecb52d3e704304ba614eaee17884204677702951
# Only HTTP reverse proxying is used. Remove optional transformation/script modules.
RUN apk del nginx-module-xslt nginx-module-image-filter nginx-module-geoip nginx-module-njs nginx-module-acme && apk upgrade --no-cache
