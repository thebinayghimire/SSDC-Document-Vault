# Local development only. Copy to .env; never commit the copy.
APP_ENV=development
# Temporary local password-only login. Set to 1 to restore authenticator prompts.
# Production always requires MFA.
MFA_ENABLED=0
DEBUG=0
POSTGRES_DB=ssdc
POSTGRES_USER=ssdc
POSTGRES_PASSWORD=local-development-only
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Managed PostgreSQL alternative. Neon supplies both variables; the direct URL
# is preferred because this app uses session advisory locks.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SCAN_MODE=clamav
# Render Free: set ENABLE_CLAMAV=false. Type, structure, and size validation remains active.
# ENABLE_CLAMAV=false
CLAMAV_HOST=clamav
# Primary storage. Existing versions keep their recorded provider.
DOCUMENT_STORAGE_PROVIDER=gdrive
# Use absolute, private secret-file paths; these placeholders are not credentials.
GOOGLE_DRIVE_CLIENT_ID_FILE=/absolute/private/path/google-client-id
GOOGLE_DRIVE_CLIENT_SECRET_FILE=/absolute/private/path/google-client-secret
GOOGLE_DRIVE_CREDENTIAL_KEY_FILE=/absolute/private/path/google-credential-key
# Render aliases (environment values take precedence over *_FILE fallbacks):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DRIVE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8080/storage/google/callback/
# Production example: https://portal.example.org/storage/google/callback/
# See docs/GOOGLE_DRIVE_SETUP.md. Never paste credentials into chat.
# Production requires independently generated SECRET_KEY and MFA_ENCRYPTION_KEY.
# Production HTTPS proxy additionally needs TLS_CERT_FILE and TLS_KEY_FILE paths.
