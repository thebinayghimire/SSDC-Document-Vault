# Local development only. Copy to .env; never commit the copy.
APP_ENV=development
# Temporary local password-only login. Set to 1 to restore authenticator prompts.
# Production always requires MFA.
MFA_ENABLED=0
# Staff self-registration, email login, and self-service email change.
# These flags are independent, but enabling either registration or email change
# requires working email delivery: in production both force
# EMAIL_DELIVERY_ENABLED=1 and a PUBLIC_BASE_URL (see the email block below).
# Checked-in default: all off. Turn on only after the SMTP settings are verified.
STAFF_SELF_REGISTRATION_ENABLED=0
EMAIL_LOGIN_ENABLED=0
SELF_REGISTERED_EMAIL_CHANGE_ENABLED=0
# Registration limits (seconds / counts / days).
# STAFF_REGISTRATION_OTP_MINUTES=10
# STAFF_REGISTRATION_OTP_MAX_ATTEMPTS=5
# STAFF_REGISTRATION_OTP_RESEND_SECONDS=60
# STAFF_REGISTRATION_OTP_HOURLY_LIMIT=5
# STAFF_REGISTRATION_IP_LIMIT=20
# STAFF_REGISTRATION_EMAIL_EXPIRY_DAYS=3
# STAFF_REGISTRATION_REVIEW_EXPIRY_DAYS=30
# STAFF_REGISTRATION_LINK_MAX_AGE_DAYS=30
# EMAIL_CHANGE_OTP_MINUTES=10
# EMAIL_CHANGE_OTP_MAX_ATTEMPTS=5
# EMAIL_CHANGE_OTP_RESEND_SECONDS=60
# EMAIL_CHANGE_OTP_HOURLY_LIMIT=5
# EMAIL_CHANGE_EXPIRY_DAYS=3
DEBUG=0
POSTGRES_DB=ssdc
POSTGRES_USER=ssdc
POSTGRES_PASSWORD=local-development-only
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Managed PostgreSQL alternative. Neon supplies both variables; the direct URL
# is preferred because this app uses session advisory locks.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SCAN_MODE=clamav
# Render: disabling scanning also requires explicit ACCEPT_NO_MALWARE_SCANNING=1.
# Type, structure, and size validation remains active.
# ENABLE_CLAMAV=false
# ACCEPT_NO_MALWARE_SCANNING=1
CLAMAV_HOST=clamav
# Primary storage. Existing versions keep their recorded provider.
DOCUMENT_STORAGE_PROVIDER=gdrive
# Use absolute, private secret-file paths; these placeholders are not credentials.
GOOGLE_DRIVE_CLIENT_ID_FILE=/absolute/private/path/google-client-id
GOOGLE_DRIVE_CLIENT_SECRET_FILE=/absolute/private/path/google-client-secret
GOOGLE_DRIVE_CREDENTIAL_KEY_FILE=/absolute/private/path/google-credential-key
# Render aliases (environment values take precedence over *_FILE fallbacks):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DRIVE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8080/storage/google/callback/
# Production example: https://portal.example.org/storage/google/callback/
# See docs/GOOGLE_DRIVE_SETUP.md. Never paste credentials into chat.

# Email delivery. 0 keeps messages in the in-process outbox (locmem) and never
# contacts a mail server, which is the safe local/test default. Set to 1 to send
# registration, verification, approval, decline, and email-change messages.
EMAIL_DELIVERY_ENABLED=0
# SMTP relay. The example values target a local development relay; replace them.
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
# EMAIL_USE_TLS and EMAIL_USE_SSL are mutually exclusive; exactly one is required
# in production. Port 587 normally pairs with TLS, port 465 with SSL.
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
# Leave both blank for an unauthenticated relay, or set both together.
EMAIL_HOST_USER=
# Prefer EMAIL_HOST_PASSWORD_FILE with a mounted secret in production.
EMAIL_HOST_PASSWORD=
# EMAIL_HOST_PASSWORD_FILE=/absolute/private/path/smtp-password
# Seconds before an SMTP connection attempt is abandoned.
EMAIL_TIMEOUT=10
# Sender shown in verification and decision messages. Must be a real mailbox in
# production; the localhost fallback is rejected there.
EMAIL_FROM_ADDRESS=SSDC Document Vault <no-reply@ssdc.example.org>
# Absolute origin used in emailed links. Required in production whenever
# registration or email change is enabled; falls back to the Render hostname.
PUBLIC_BASE_URL=https://portal.example.org

# Durable notification outbox retry policy. `manage.py process_notifications`
# uses these to back off failed deliveries before dead-lettering them.
# EMAIL_NOTIFICATION_MAX_ATTEMPTS=5
# EMAIL_NOTIFICATION_BACKOFF_BASE_SECONDS=60
# EMAIL_NOTIFICATION_BACKOFF_MAX_SECONDS=3600
# EMAIL_NOTIFICATION_LEASE_SECONDS=900

# Production requires independently generated SECRET_KEY and MFA_ENCRYPTION_KEY.
# Production HTTPS proxy additionally needs TLS_CERT_FILE and TLS_KEY_FILE paths.
